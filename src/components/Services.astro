---
import {services} from '../data/site';
import SectionHeading from './SectionHeading.astro';
---
<section id="services" class="section white-section"><div class="container"><div class="section-top"><SectionHeading eyebrow="Core services" title="A stronger foundation. A clearer way forward."/><p class="section-aside">Practical HR advice and implementation support, shaped around your business stage and priorities.</p></div><div class="service-grid">{services.map((service,i)=><article class="service-card"><span class="number">0{i+1}</span><h3>{service.title}</h3><p>{service.description}</p><ul>{service.items.map(item=><li>{item}</li>)}</ul></article>)}</div><div class="advisory-strip"><div><p class="eyebrow">Ongoing HR Advisory & Partnership</p><h3>Senior HR perspective, alongside your leadership team.</h3><p>Build a consistent rhythm for people decisions, governance and implementation as your organisation evolves.</p></div><a class="text-link" href="#contact">Discuss an advisory engagement <span aria-hidden="true">↗</span></a></div></div></section>
