---
import {projects} from '../data/site';
import SectionHeading from './SectionHeading.astro';
---
<section id="special-projects" class="section dark-section"><div class="container"><div class="section-top"><SectionHeading eyebrow="Defined challenge. Focused engagement." title="Focused HR transformation projects."/><div class="section-aside"><p>Address a specific priority without a long-term advisory arrangement. Agree the scope, deliverables and measures of progress at the outset.</p><a class="text-link" href="#contact">Talk through your project <span aria-hidden="true">↗</span></a></div></div><div class="project-grid">{projects.map((project,i)=><article><span class="project-number">0{i+1}</span><h3>{project.title}</h3><p>{project.text}</p><ul class="tags">{project.tags.map(tag=><li>{tag}</li>)}</ul></article>)}</div></div></section>
