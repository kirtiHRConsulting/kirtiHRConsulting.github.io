---
import '../styles/global.css';
import { site } from '../data/site';
const canonical = Astro.site ? new URL(import.meta.env.BASE_URL, Astro.site).href : undefined;
const schema = { '@context':'https://schema.org', '@type':'Person', name:site.name, jobTitle:'HR Consultant', email:site.contact.email, telephone:site.contact.phone, address:{'@type':'PostalAddress',addressLocality:'Mumbai',addressCountry:'IN'}, ...(canonical ? {url:canonical} : {}), workLocation:{'@type':'Place',name:site.location}, knowsAbout:['HR strategy','Organisation design','Workforce planning','Performance management','HRMS'] };
---
<!doctype html>
<html lang="en-IN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{site.title}</title><meta name="description" content={site.description}/><meta name="theme-color" content="#122d39"/><link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`}/>{canonical && <link rel="canonical" href={canonical}/>}<meta property="og:type" content="website"/><meta property="og:title" content={site.title}/><meta property="og:description" content={site.description}/><meta property="og:locale" content="en_IN"/>{canonical && <meta property="og:url" content={canonical}/>}<meta name="twitter:card" content={site.socialImage ? 'summary_large_image':'summary'}/>{site.socialImage && canonical && <meta property="og:image" content={new URL(site.socialImage,canonical).href}/>}<script type="application/ld+json" set:html={JSON.stringify(schema)}/></head><body><a class="skip-link" href="#main">Skip to content</a><slot/></body></html>
